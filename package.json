{
  "name": "opencode-usage-coach",
  "version": "0.13.2",
  "description": "opencode closed-loop usage coach — quota SENSE -> coaching DECIDE -> loop ACT + TUI integration",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js",
    "./cli": "./dist/cli.js"
  },
  "bin": {
    "usage-coach": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:coverage": "c8 --reporter=text --reporter=lcov --reporter=json-summary node --import tsx --test test/**/*.test.ts",
    "coverage:badge": "node scripts/coverage-badge.mjs",
    "prepack": "tsup"
  },
  "files": [
    "dist",
    "agents",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "quota",
    "usage",
    "coach",
    "loop",
    "llm",
    "harness"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.14",
    "@opentui/core": ">=0.4.0",
    "@opentui/solid": ">=0.4.0",
    "solid-js": ">=1.9.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opencode-ai/plugin": "*",
    "@opentui/core": ">=0.4.0",
    "@opentui/solid": ">=0.4.0",
    "@types/node": "^26.1.1",
    "c8": "^11.0.0",
    "esbuild-plugin-solid": "^0.6.0",
    "eslint": "^10.6.0",
    "eslint-plugin-solid": "^0.14.5",
    "globals": "^17.7.0",
    "solid-js": "^1.9",
    "tsup": "^8.5",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "typescript-eslint": "^8.63.0"
  }
}