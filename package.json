{
  "name": "opencode-usage-coach",
  "version": "0.1.2",
  "description": "opencode closed-loop usage coach \u2014 quota SENSE -> coaching DECIDE -> loop ACT + TUI integration",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepack": "tsup"
  },
  "files": [
    "dist",
    "agents",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "quota",
    "usage",
    "coach",
    "loop",
    "zai",
    "glm"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.14",
    "@opentui/core": ">=0.4.0",
    "@opentui/solid": ">=0.4.0",
    "solid-js": ">=1.9.12"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "*",
    "@opentui/core": ">=0.4.0",
    "@opentui/solid": ">=0.4.0",
    "esbuild-plugin-solid": "^0.6.0",
    "solid-js": "^1.9",
    "tsup": "^8.5",
    "typescript": "^5"
  }
}